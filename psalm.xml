<?xml version="1.0"?>
<psalm
    phpVersion="8.2"
    cacheDirectory="./var/cache/psalm"
    checkForThrowsDocblock="true"
    hideExternalErrors="true"
    ignoreInternalFunctionNullReturn="false"
    ignoreInternalFunctionFalseReturn="false"
    strictBinaryOperands="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="https://getpsalm.org/schema/config"
    xsi:schemaLocation="vendor-bin/phpunit/vendor/vimeo/psalm/config.xsd"
    errorBaseline=".baseline-psalm.xml"
>
    <projectFiles>
        <directory name="src"/>
        <directory name="tests"/>
        <ignoreFiles>
            <directory name="vendor"/>
        </ignoreFiles>
    </projectFiles>

    <issueHandlers>
        <MissingThrowsDocblock errorLevel="suppress" />
        <DocblockTypeContradiction errorLevel="suppress" />
        <MixedAssignment errorLevel="suppress" />
        <RedundantConditionGivenDocblockType errorLevel="suppress" />
        <PossiblyUnusedMethod errorLevel="suppress" />
        <ReferenceConstraintViolation errorLevel="suppress" />
        <!-- The whole component is deprecated: its tests exercise the deprecated API on purpose -->
        <DeprecatedClass>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </DeprecatedClass>
        <DeprecatedMethod>
            <errorLevel type="suppress">
                <directory name="tests"/>
            </errorLevel>
        </DeprecatedMethod>
    </issueHandlers>
    <plugins>
        <pluginClass class="Psalm\PhpUnitPlugin\Plugin"/>
    </plugins>
</psalm>
